# Copy this file to .env and fill in your real key(s). Never commit .env itself.
#
#   cp .env.example .env        (bash)
#   Copy-Item .env.example .env (PowerShell)

# Required — the primary extraction provider (Claude vision reads the order image
# directly and returns structured JSON). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — fallback / cross-check provider. Only needed if you enable the
# self-consistency check on money-bearing fields (--cross-check), or if you want to
# run with --extractor gemini instead of Claude. Get a key at https://aistudio.google.com/
GEMINI_API_KEY=

# Optional — which Claude model to use for extraction. Defaults to a current
# Claude model if unset.
FIC_CLAUDE_MODEL=claude-opus-5
# What reads the order image: gemini | claude (vision LLMs, need a key above)
# or ocr (local, offline, no key -- needs `uv sync --extra ocr`; knows only this
# order template). `--provider` on the command line overrides this per run.
FIC_PROVIDER=gemini

# Model names, so switching never means editing code.
# Gemini: prefer a "-latest" alias -- pinned versions get retired (gemini-2.5-pro
# already was, and returned a 404 that looked like a config error).
# Other options seen on this key: gemini-flash-latest (faster/cheaper),
# gemini-3.1-pro-preview, gemini-2.5-flash
FIC_GEMINI_MODEL=gemini-flash-latest

# How many times to retry a TRANSIENT Gemini failure (503 overload / 429 rate
# limit) with exponential backoff: 2s, 4s, 8s, 16s. Free-tier flash returns 503
# often enough that this matters -- four in a row was observed, then success.
# 0 disables retrying. Non-transient errors (bad key, retired model) never retry.
FIC_GEMINI_RETRIES=4

# Seconds to wait for ONE Gemini request before giving up on it and retrying.
# The SDK's own default is unlimited, which means a stalled request hangs the
# whole run silently -- measured live: one attempt sat for 91s, the retry
# succeeded in 63s.
FIC_GEMINI_TIMEOUT=90

# Optional — path to the Fakturama executable. Auto-detected from the usual
# Program Files locations if unset; set this only if your install path differs.
FIC_FAKTURAMA_EXE=C:\Program Files (x86)\Fakturama\Fakturama.exe

# Optional — override log level (DEBUG, INFO, WARNING). Defaults to INFO.
FIC_LOG_LEVEL=INFO

# Re-read the image when the first reading is missing fields the debtor match
# depends on (e.g. it returned no first/last name). The two readings must agree
# on every money field; the more complete one wins. 0 disables.
FIC_EXTRACT_RETRIES=1

# Treat a still-incomplete extraction as a HALT instead of a warning. Off by
# default because a company-only order legitimately has no contact person.
FIC_EXTRACT_STRICT=0
